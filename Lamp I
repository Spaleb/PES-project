/* USER CODE BEGIN 4 */
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData);

    uint8_t target = RxData[0]; //Target - source - commando structure.
    uint8_t source = RxData[1];
    uint8_t cmd = RxData[2];

    if (target != NODE_LAMP)
        return;

    if (cmd == CMD_SET_LIGHT) //Als commando voor de lamp is ontvangen.
    {
        uint8_t r = RxData[3]; //Vul de data in.
        uint8_t g = RxData[4];
        uint8_t b = RxData[5];
        uint8_t brightness = RxData[6];

        setLight(r, g, b, brightness); //Stuur de actuator aan met de functie.
        sendAck(source); //Stuur bevestiging terug.
    }
}

void setLight(uint8_t r, uint8_t g, uint8_t b, uint8_t brightness)
{
    r = (r * brightness) / 100; //Pas de helderheid met de kleur toe op schaal.
    g = (g * brightness) / 100;
    b = (b * brightness) / 100;
}

void sendAck(uint8_t target)
{
    TxData[0] = target;
    TxData[1] = NODE_LAMP; //Source
    TxData[2] = CMD_ACK; //Data/commando.
    TxData[3] = 0x00; //Laten weten dat het okay is.

    HAL_CAN_AddTxMessage(&hcan, &TxHeader, TxData, &TxBuffer);
}
