#include <ESP8266WiFi.h>

const char* ssid = "NSELab";
const char* password = "NSELabWiFi";
const char* serverIP = "145.52.127.166";
const int serverPort = 5000;

const char MY_LETTER = 'A';   // 'A' voor WEMOS1, 'B' voor WEMOS2

WiFiClient client;

bool blink = false;
unsigned long lastToggle = 0;
bool ledState = HIGH;   // HIGH = uit (active LOW)

void setup() {
  Serial.begin(115200);

  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH); // LED uit

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) delay(500);

  client.connect(serverIP, serverPort);
  client.println(MY_LETTER);   // meld jezelf als A of B
}

void loop() {
  if (!client.connected()) {
    client.connect(serverIP, serverPort);
    client.println(MY_LETTER);
    delay(1000);
    return;
  }

  // ---- commando ontvangen ----
  if (client.available()) {
    char cmd = client.read();

    if (cmd == '1') {        // 1 = BLINK
      blink = true;
      client.println("A Led aan");
    }
    else if (cmd == '2') {   // 2 = UIT
      blink = false;
      digitalWrite(LED_BUILTIN, HIGH);
      client.println("A Led uit");
    }
  }

  // ---- blink logica ----
  if (blink && millis() - lastToggle >= 1000) {
    lastToggle = millis();
    ledState = !ledState;
    digitalWrite(LED_BUILTIN, ledState);
  }
}
